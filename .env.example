# Banco de Dados PostgreSQL (Neon / Vercel Postgres)
# Se omitido localmente, utiliza SQLite (./recife_seguro.db) automaticamente com seed inicial
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.us-east-1.aws.neon.tech/recife_seguro?sslmode=require

# Chave opcional da API Google Gemini (para tradução generativa dinâmica)
# Caso não informada, o sistema aciona automaticamente o motor determinístico validado (< 50ms)
GEMINI_API_KEY=

